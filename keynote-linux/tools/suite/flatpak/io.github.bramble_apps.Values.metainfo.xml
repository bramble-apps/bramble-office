<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.bramble_apps.Values</id>
  <name>Values</name>
  <summary>Work with spreadsheets</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.bramble_apps">
    <name>Bramble Office</name>
  </developer>
  <description>
      <p>Values is a spreadsheet app made of sheets with free-standing tables, charts, text and pictures. It opens and saves Numbers files, and opens and saves Excel workbooks and CSV.</p>
      <p>Use hundreds of functions, categories, filters, sorting, conditional highlighting and interactive charts, starting from a blank sheet or a template.</p>
  </description>
  <launchable type="desktop-id">io.github.bramble_apps.Values.desktop</launchable>
  <url type="homepage">https://bramble-apps.github.io</url>
  <url type="bugtracker">https://github.com/bramble-apps/bramble-office/issues</url>
  <url type="vcs-browser">https://github.com/bramble-apps/bramble-office</url>
  <url type="donation">https://www.paypal.com/donate/?hosted_button_id=5EP8EM86U9P7Q</url>
  <branding>
    <color type="primary" scheme_preference="light">#f6f5f4</color>
    <color type="primary" scheme_preference="dark">#3d3846</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <image>https://bramble-apps.github.io/screenshots/values-2.jpg</image>
      <caption>A chart beside its table, in dark mode</caption>
    </screenshot>
    <screenshot>
      <image>https://bramble-apps.github.io/screenshots/values-1.jpg</image>
      <caption>A sheet with a table and a chart</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <releases>
    <release version="0.4.0" date="2026-11-04">
      <description>
        <p>First release on Flathub.</p>
      </description>
    </release>
  </releases>
</component>
